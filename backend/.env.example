PROJECT_NAME="AarogyaSeva - Rural Healthcare Assistance Platform"
ENVIRONMENT="development"
API_V1_STR="/api"
SECRET_KEY="rural-healthcare-super-secret-jwt-key-for-milestone-one-development"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default to SQLite for immediate zero-friction local execution,
# or set to PostgreSQL when running locally or via Docker:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/rural_health_db"
DATABASE_URL="sqlite:///./rural_health.db"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="rural_health_db"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf", "jpg", "jpeg", "png"]

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Milestone 2: AI Engine & Translation Configuration
# Optional: Optical Character Recognition path override (auto-detected by default)
# TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
# Optional external AI API keys (system works fully with built-in neural translator & NLP)
# GEMINI_API_KEY=""


